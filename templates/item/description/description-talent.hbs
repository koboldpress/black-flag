<section>
	<div class="category">
		{{ formField fields.type.fields.category value=source.type.category options=type.categoryOptions
		             classes="label-top" label="BF.Feature.Talent.Category.Label" localize=true rootId=partId }}
	</div>
	{{#if (or editable system.restriction.label)}}
		<div class="prerequisite">
			<span>
				{{ localize "BF.Prerequisite.Label" }}: {{#if system.restriction.label}}
					{{~ system.restriction.label }}{{else}}{{ localize "COMMON.None" }}{{/if}}
			</span>
			{{#if editable}}
				<button type="button" class="link-button" data-action="showConfiguration" data-type="prerequisite"
								data-tooltip aria-label="{{ localize 'BF.Prerequisite.Action.Config' }}">
					<i class="fa-solid fa-cog" inert></i>
				</button>
			{{/if}}
		</div>
	{{/if}}
</section>
