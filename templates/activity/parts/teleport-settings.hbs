	<fieldset>
		<legend>{{ localize "BF.TELEPORT.Details" }}</legend>
		{{ formField systemFields.distance.fields.override value=source.system.distance.override rootId=partId }}
		{{#blackFlag-formGroup "BF.TELEPORT.FIELDS.distance.value.label"}}
			{{ formField systemFields.distance.fields.value value=distance.data.value classes="label-top"
									 placeholder="∞" disabled=distance.disabled rootId=@root.partId }}
			{{ formField systemFields.distance.fields.unit value=distance.data.unit classes="label-top"
									 options=CONFIG.distanceUnits.localizedOptions disabled=distance.disabled rootId=@root.partId }}
		{{/blackFlag-formGroup}}
	</fieldset>
