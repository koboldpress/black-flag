<blackFlag-uses name="{{ name }}">
	<fieldset>
		<legend>{{ localize "BF.Uses.Label" }}</legend>
		{{ formField fields.uses.fields.max name="$.max" value=source.max placeholder="0" localize=true rootId=partId }}
		{{ formField fields.uses.fields.spent name="$.spent" value=derived.spent localize=true
		             rootId=partId }}
		{{#if item.system.isPhysical}}
			{{ formField fields.uses.fields.consumeQuantity name="$.consumeQuantity" value=derived.consumeQuantity
			             localize=true rootId=partId }}
		{{/if}}
	</fieldset>

	<fieldset>
		<legend>{{ localize "BF.Recovery.Label" }}</legend>
		<ul class="configuration-list">
			{{#each usesRecovery}}
				<li data-index="{{ @index }}">
					{{#blackFlag-formGroup classes="full-width"}}
						{{!-- Period --}}
						{{ formField fields.period name=(concat prefix "period") value=source.period options=data.periodOptions
						             blank=false localize=true classes="label-top" rootId=@root.partId }}

						{{!-- Type --}}
						{{#unless (eq source.period "recharge")}}
						  {{ formField fields.type name=(concat prefix "type") value=source.type classes="label-top" localize=true
							             options=@root.CONFIG.recoveryTypes.localizedOptions blank=false rootId=@root.partId }}
						{{/unless}}

						{{!-- Formula --}}
						{{#if (eq source.period "recharge")}}{{log data.recharge.options}}
							{{ formField fields.formula name=(concat prefix "formula") value=source.formula localize=true
							             options=data.recharge.options classes="label-top" label="BF.Recovery.Recharge.Trigger"
							             blank=false rootId=@root.partId }}
						{{else if (eq source.type "formula")}}
							{{ formField fields.formula name=(concat prefix "formula") value=source.formula localize=true
							             classes="label-top" rootId=@root.partId }}
						{{/if}}
					{{/blackFlag-formGroup}}
					<div class="controls">
						{{#if @root.editable}}
							<button type="button" class="link-button" data-action="delete"
							        data-tooltip="BF.Recovery.Action.Delete"
											aria-label="{{ localize 'BF.Recovery.Action.Delete' }}">
								<i class="fa-solid fa-trash" inert></i>
							</button>
						{{/if}}
					</div>
				</li>
			{{else}}
				{{#unless editable}}
					<li class="add-control">{{ localize "None" }}</li>
				{{/unless}}
			{{/each}}
			{{#if editable}}
				<li class="add-control">
					<button type="button" class="link-button" data-action="add">
				 		<i class="fa-solid fa-plus" inert></i> {{ localize "BF.Recovery.Action.Add" }}
					</button>
				</li>
			{{/if}}
		</ul>
	</fieldset>
</blackFlag-uses>
